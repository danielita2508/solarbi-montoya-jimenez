{
  "uid": "solarbi-operacion",
  "title": "SolarBI · Operación y calidad",
  "tags": [
    "solarbi",
    "grupo50"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "",
  "time": {
    "from": "2026-10-05T00:00:00.000Z",
    "to": "2026-10-08T00:00:00.000Z"
  },
  "templating": {
    "list": [
      {
        "name": "dispositivo",
        "label": "Dispositivo",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "solarbi-pg"
        },
        "query": "SELECT dispositivo_key AS __value, nombre AS __text FROM dwh.dim_dispositivo ORDER BY 1",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Irradiancia y potencia AC cada 5 minutos",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "solarbi-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 18,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "solarbi-pg"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT ts AS time,\n       irradiancia_wm2 AS \"Irradiancia (W/m²)\",\n       p_ac_kw AS \"Potencia AC (kW)\"\nFROM silver.lectura_5min\nWHERE $__timeFilter(ts)\n  AND dispositivo_id IN ($dispositivo)\nORDER BY ts",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "axisPlacement": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Potencia AC (kW)"
            },
            "properties": [
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "unit",
                "value": "kwatt"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Irradiancia (W/m²)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "watt"
              }
            ]
          }
        ]
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "% de datos válidos",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "solarbi-pg"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "solarbi-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT 100.0 * sum(lecturas_validas) / sum(lecturas_leidas) AS \"% datos válidos\"\nFROM dwh.fact_energia_dia\nWHERE fecha BETWEEN $__timeFrom()::date AND $__timeTo()::date\n  AND dispositivo_key IN ($dispositivo)",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 90
              },
              {
                "color": "green",
                "value": 95
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "barchart",
      "title": "Energía diaria (kWh)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "solarbi-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "solarbi-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT fecha::text AS \"Día\", sum(energia_kwh) AS \"Energía (kWh)\"\nFROM dwh.fact_energia_dia\nWHERE fecha BETWEEN $__timeFrom()::date AND $__timeTo()::date\n  AND dispositivo_key IN ($dispositivo)\nGROUP BY fecha ORDER BY fecha",
          "refId": "A"
        }
      ],
      "options": {
        "xField": "Día",
        "legend": {
          "showLegend": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "kwatth",
          "decimals": 2
        },
        "overrides": []
      }
    }
  ]
}